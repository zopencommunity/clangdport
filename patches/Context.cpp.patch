+#ifdef __MVS__
+// z/OS does not support thread_local storage.
+// Use POSIX Thread-Specific Data (TSD) instead.
+
+namespace {
+
+static pthread_key_t contextKey;
+static pthread_once_t contextKeyOnce = PTHREAD_ONCE_INIT;
+
+// Destructor called when a thread exits
+static void destroyContext(void *ptr) {
+  delete static_cast<Context *>(ptr);
+}
+
+// Initialize the pthread key once
+static void createContextKey() {
+  pthread_key_create(&contextKey, destroyContext);
+}
+
+} // anonymous namespace
+
+static Context &currentContext() {
+  pthread_once(&contextKeyOnce, createContextKey);
+
+  Context *C = static_cast<Context *>(pthread_getspecific(contextKey));
+  if (!C) {
+    // First access in this thread - create a new Context
+    C = new Context(Context::empty());
+    pthread_setspecific(contextKey, C);
+  }
+  return *C;
+}
+
+#else
+// Non-z/OS platforms: use thread_local
+
 static Context &currentContext() {
   static thread_local auto C = Context::empty();
   return C;
 }
 
+#endif // __MVS__
+
 const Context &Context::current() { return currentContext(); }
 
